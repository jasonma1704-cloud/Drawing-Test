# ====================== 基础配置 ======================
# 应用名称（标识用途）
APP_NAME=AI Mail Workflow
# 运行环境：production=正式运行 / development=开发测试
ENVIRONMENT=production
# 轮询间隔：每隔 120 秒（2分钟）检查一次新邮件
POLL_INTERVAL_SECONDS=120

# ====================== 邮箱 IMAP 配置 ======================
# 邮箱 IMAP 服务器地址
imap_host=imap.qq.com
# 邮箱 IMAP 端口（993 为标准SSL安全端口）
imap_port=993
# 邮箱登录账号
imap_user=2834926690@qq.com
# 邮箱密码/授权码
imap_password=fyyrkzhrsdbmddbe
# 要监听的邮箱文件夹：INBOX=收件箱
imap_folder=INBOX
# 启用SSL加密连接
imap_ssl=true
# 发件人过滤
imap_sender_filter=

# ====================== AI 大模型（通义千问）配置 ======================
# 通义千问 API Key（必须替换成你自己的）
QWEN_API_KEY=sk-bf777a4517f84d20a085d65026be73fa
# AI 接口地址（阿里云官方，无需修改）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 使用的AI模型：qwen-vl-max 支持图文解析
QWEN_MODEL=qwen-vl-max-latest
# 温度系数：0=回答最固定、严谨、不随机；越大越创意发散
QWEN_TEMPERATURE=0
# AI 返回内容最大长度（token 数）
QWEN_MAX_TOKENS=1200

# ====================== 飞书通知配置 ======================
# 飞书机器人 Webhook 地址（群机器人创建后获取）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/944aa62f-98f8-496f-8966-b8e6ff80b6fc
# 通知时需要@的人员：格式=姓名:飞书用户ID,姓名:飞书用户ID
FEISHU_ENGINEER_USER_IDS=通知工程师:a75ff7be

# ====================== 邮件附件处理规则 ======================
# 允许解析的附件格式
ATTACHMENT_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp
# 单个附件最大允许大小（MB）
MAX_ATTACHMENT_MB=20
# PDF 文件最多解析前几页（避免超大文件）
MAX_PDF_PAGES=5

# ====================== 邮件读取策略 ======================
# 是否只处理未读邮件：true=只处理未读 / false=处理所有邮件
USE_UNREAD_ONLY=true
# 处理成功后是否标记为已读：true=标记 / false=不标记
MARK_SEEN_AFTER_SUCCESS=false